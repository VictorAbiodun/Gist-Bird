# Site URL (for metadata, redirects, and auth callbacks)
NEXT_PUBLIC_SITE_URL=https://gist-bird.vercel.app
# Supabase project (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Server only. Needed for "Delete account". Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
# Comma-separated school email domains allowed to sign up (also add them to the allowed_domains table)
ALLOWED_EMAIL_DOMAINS=school.edu.ng
